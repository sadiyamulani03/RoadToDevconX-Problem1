# Local Anvil defaults. Never commit real keys or passwords.
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
ANNOUNCER_ADDRESS=0x0000000000000000000000000000000000000000
ROUTER_ADDRESS=0x0000000000000000000000000000000000000000

# Keystore password (at least 8 characters). Prefer --password-file over an env var.
STEALTH_KEYSTORE_PASSWORD=replace-with-a-long-demo-password

# Test-only keys for a local Anvil chain. Never use these values on a real network.
PAYER_PRIVATE_KEY=replace-with-a-local-test-only-private-key
DEPLOYER_PRIVATE_KEY=replace-with-a-local-test-only-private-key

# Optional demo password and RPC for scripts.
DEMO_PASSWORD=replace-with-a-demo-password
